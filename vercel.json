{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.usamajaved.ie"
        }
      ],
      "destination": "https://usamajaved.ie/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "usamajaved-solar.vercel.app"
        }
      ],
      "destination": "https://usamajaved.ie/$1",
      "permanent": true
    },
    {
      "source": "/tools/advanced-excel/115-kWp-commercial-rooftop-excel-demo.xlsx",
      "destination": "/tools/advanced-excel/115-kWp-commercial-rooftop-bom-and-cost-tracker.xlsx",
      "permanent": true
    },
    {
      "source": "/tools/sql/115-kWp-commercial-rooftop-sql-demo.sql",
      "destination": "/tools/sql/115-kWp-commercial-rooftop-procurement-database.sql",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(feature|projects|site|me|tools|certificates|photos|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)(__next\\.|index\\.txt|_not-found)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/roles/(planning|project-engineering|site-delivery|energy-analytics)\\.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
